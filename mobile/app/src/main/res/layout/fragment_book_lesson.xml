<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:fontFamily="serif"
            android:text="Schedule a Session"
            android:textColor="@color/primary_brand"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="serif"
                    android:text="Select Date"
                    android:textColor="@color/primary_brand"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBookingDate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_pill_input"
                    android:backgroundTint="@color/secondary_bg"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:drawableTint="@color/primary_brand"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="Select a Date"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="serif"
                    android:text="Preferred Playstyle"
                    android:textColor="@color/primary_brand"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spnPlaystyle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_pill_input"
                    android:backgroundTint="@color/secondary_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="serif"
                    android:text="Available Lesson Times"
                    android:textColor="@color/primary_brand"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llAvailableTimesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnConfirmBooking"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#BDBDBD"
                    android:enabled="false"
                    android:fontFamily="serif"
                    android:text="Confirm Booking"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="999dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>