<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:fontFamily="serif"
            android:text="Tactics Board"
            android:textColor="@color/primary_brand"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="#E7DCCF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTurnIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_input"
                        android:backgroundTint="@color/secondary_bg"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:text="White to move"
                        android:textColor="@color/text_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnFlipBoard"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_popup_sync"
                        app:tint="@color/text_dark" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/boardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="350dp"
                    android:background="#D18B47"> <WebView
                    android:id="@+id/chessWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textAlignment="center" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btnFastRewind" android:layout_width="50dp" android:layout_height="40dp" android:text="&lt;&lt;" android:backgroundTint="@color/secondary_bg" android:textColor="@color/text_dark" android:layout_marginEnd="8dp"/>
                    <Button android:id="@+id/btnPrevMove" android:layout_width="50dp" android:layout_height="40dp" android:text="&lt;" android:backgroundTint="@color/secondary_bg" android:textColor="@color/text_dark" android:layout_marginEnd="8dp"/>
                    <Button android:id="@+id/btnNextMove" android:layout_width="50dp" android:layout_height="40dp" android:text="&gt;" android:backgroundTint="@color/secondary_bg" android:textColor="@color/text_dark" android:layout_marginEnd="8dp"/>
                    <Button android:id="@+id/btnFastForward" android:layout_width="50dp" android:layout_height="40dp" android:text="&gt;&gt;" android:backgroundTint="@color/secondary_bg" android:textColor="@color/text_dark"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="#E7DCCF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="serif"
                    android:text="Move History"
                    android:textColor="@color/primary_brand"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_live_surface"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvMoveHistoryPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. e4 e5\n2. Nf3 Nc6\n3. Bc4 Bc5..."
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </ScrollView>

                <Button
                    android:id="@+id/btnClearLine"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/primary_brand"
                    android:fontFamily="serif"
                    android:text="Clear Line"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
