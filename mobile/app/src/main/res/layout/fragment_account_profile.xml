<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:fontFamily="serif"
            android:text="Edit Profile"
            android:textColor="@color/primary_brand"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="#E7DCCF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="serif"
                    android:text="Full Name"
                    android:textColor="@color/primary_brand"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etProfileFullName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_form_field_clean"
                    android:paddingHorizontal="16dp"
                    android:hint="Your full name"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#9A8A7B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="serif"
                    android:text="Chess Username"
                    android:textColor="@color/primary_brand"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etProfileChessUsername"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_form_field_clean"
                    android:hint="Chess.com or Lichess handle"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#9A8A7B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="serif"
                    android:text="Personal ELO Rating"
                    android:textColor="@color/primary_brand"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etProfileElo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/bg_form_field_clean"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:hint="0"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#9A8A7B" />

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="@color/primary_brand"
                    android:fontFamily="serif"
                    android:text="Save Updates"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
